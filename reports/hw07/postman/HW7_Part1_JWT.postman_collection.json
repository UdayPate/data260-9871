  "item": [
    {
      "name": "00 - Login as READER (expect 200 + JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Valid credentials for the reader demo user. The returned access_token is saved in {{reader_token}}.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"reader_user\",\n  \"password\": \"Reader2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test(\"response has a bearer access_token\", function () { pm.expect(j.token_type).to.eql(\"bearer\"); pm.expect(j.access_token.split(\".\").length).to.eql(3); });",
              "pm.collectionVariables.set(\"reader_token\", j.access_token);"
            ]
          }
        }
      ]
    },
