        "description": "A valid token, but readers may not create.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{reader_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fixture_name\": \"HW7 Postman demo fixture\",\n  \"teams_players\": \"Lions vs Tigers\",\n  \"fixture_code\": \"{{fxCode}}\",\n  \"spots_available\": 12,\n  \"home_team_id\": \"{{homeTeamId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"fxCode\", \"FX-9871-9\" + Math.floor(1000 + Math.random() * 8999));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 403\", function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
