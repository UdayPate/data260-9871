      ]
    },
    {
      "name": "05 - GET /auth/me with an INVALID token (expect 401)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        },
        "description": "A token that is not a JWT / not signed by this server.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{invalid_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"detail says Invalid token\", function () { pm.expect(pm.response.json().detail).to.eql(\"Invalid token\"); });"
            ]
          }
        }
      ]
    },
