        "description": "Identity and role of the authenticated user.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{moderator_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"returns username and role\", function () { const j = pm.response.json(); pm.expect(j.username).to.eql(\"moderator_user\"); pm.expect(j.role).to.eql(\"moderator\"); });"
            ]
          }
        }
