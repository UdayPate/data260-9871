{
  "info": {
    "name": "Uday Patel - DATA-260 HW5 Part 1.II",
    "description": "Community Sports League Fixtures API (SID4 9871, PORT_BASE 8871, database s9871_rel).\n\nRun the requests top to bottom. 00 captures the session token; 01 and 05 store {{teamId}} and {{fixtureId}}; 13 and 14 clean up, so the collection is safe to run repeatedly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Login (run this first)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Authenticates and stores the session token in the {{token}} collection variable.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"league_admin@example.com\",\n  \"password\": \"GoLions2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The session cookie is marked Secure. Over plain http, Postman's cookie jar",
              "// may refuse to store or resend it, so the token is pulled out of the raw",
              "// Set-Cookie header and kept in a collection variable instead. Every other",
              "// request then sends it explicitly as a Cookie header.",
              "let token = \"\";",
              "const h = pm.response.headers.find(x => x.key.toLowerCase() === \"set-cookie\");",
              "if (h) { const m = /session_token=([^;]+)/.exec(h.value); if (m) token = m[1]; }",
              "if (!token) { try { token = pm.cookies.get(\"session_token\") || \"\"; } catch (e) {} }",
              "if (token) { pm.collectionVariables.set(\"token\", token); }",
              "",
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"session token captured\", () => pm.expect(token).to.not.eql(\"\"));",
              "console.log(token ? \"token captured, length \" + token.length",
              "                  : \"NO TOKEN - see the Plan B note in the instructions\");"
            ]
          }
        }
      ]
    },
