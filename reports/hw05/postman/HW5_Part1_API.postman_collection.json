              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"teamId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
