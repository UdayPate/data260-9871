        "description": "Expect 201 with id, team_code and both timestamps.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"team_name\": \"Evergreen Kestrels\",\n  \"home_ground\": \"Evergreen Community Park, San Jose\",\n  \"team_code\": \"TM-0500\"\n}",
          "options": {
