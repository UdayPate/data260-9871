      "symptom": "mcp dev code\\\\meals_server.py --with typer -> Inspector loops on File not found: ...codemeals_server.py",
      "root_cause": "Inspector browser client joins its argv array into one space-joined string before sending it to the proxy over the wire; the proxy re-splits that string using POSIX shell-escaping rules (backslash escapes next char), silently deleting the backslash. Confirmed from the raw proxy connection log, not assumed.",
      "is_mcp_sdk_bug": false,
      "is_server_bug": false,
      "location": "@modelcontextprotocol/inspector client/proxy handshake",
      "fix": "use forward slashes in the mcp dev file argument: mcp dev code/meals_server.py --with typer",
      "log_section": "RUN_LOG.txt 2e"
    },
